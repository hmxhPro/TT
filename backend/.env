# ==============================
# Environment Configuration
# Copy this file to .env and fill in values
# ==============================

# HuggingFace Configuration
# Use local cache only, don't try to connect to huggingface.co
#HF_HUB_OFFLINE=1
#TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1

# Ultralytics offline mode
YOLO_OFFLINE=1
ULTRALYTICS_OFFLINE=1

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# File Storage
UPLOAD_DIR=./uploads
RESULTS_DIR=./results

# Detection Model
# Options: "florence2", "grounding_dino", "yoloe"
DETECTION_MODEL=yoloe

# GPU Device (e.g. "cuda:0", "cuda:1", "cpu")
DEVICE=cuda:0

# Florence-2 model variant (if using Florence-2)
FLORENCE2_MODEL_ID=microsoft/Florence-2-large

# Grounding DINO config and checkpoint (if using Grounding DINO)
GDINO_CHECKPOINT_PATH=./models/groundingdino/weights/groundingdino_swint_ogc.pth

# YOLOE 基座权重：仅用于「开放词表检测」——默认视频检测器 + 零样本图片检测（set_classes）。
# 当前用 YOLOE 家族：yoloe-11l-seg.pt / yoloe-11m-seg.pt ...（建议用绝对路径）
YOLOE_BASE_MODEL=/home/hmxh/workspace/sodv3/SOD/backend/models/yolo/yoloe-11l-seg.pt

# 自定义训练基座权重：普通 YOLOv11 检测模型（用 YOLO 加载，走标准检测训练器）。
# 与 YOLOE_BASE_MODEL 解耦——开放检测仍用 YOLOE，训练改用普通 YOLO 才能正常学习分类头。
TRAIN_BASE_MODEL=/home/hmxh/workspace/sodv3/SOD/backend/models/yolo/yolo11l.pt
# SAHI slicing parameters for small object detection
SAHI_SLICE_HEIGHT=640
SAHI_SLICE_WIDTH=640
SAHI_OVERLAP_HEIGHT_RATIO=0.2
SAHI_OVERLAP_WIDTH_RATIO=0.2

# Detection thresholds
BOX_THRESHOLD=0.35
TEXT_THRESHOLD=0.25

# Frame quality filtering (skip black/dark/overexposed frames)
ENABLE_FRAME_QUALITY_CHECK=true
BLACK_FRAME_THRESHOLD=15.0
DARK_FRAME_THRESHOLD=30.0
BRIGHT_FRAME_THRESHOLD=240.0
MIN_FRAME_STD_DEV=10.0

# Frame saving and compression
# Options: "all" | "keyframes_only" | "detections_only" | "unique_targets" | "best_shot"
# - keyframes_only: every detection keyframe (incl. those with no boxes)
# - detections_only: only keyframes that actually have ≥1 detection drawn
# - unique_targets: only frames showing a NEW ByteTrack track_id, then the
#   same target is re-saved at most every TRACK_SAVE_COOLDOWN_SEC seconds.
#   Fixes the "same object saved on every keyframe" duplication on
#   continuous video.
# - best_shot: exactly ONE snapshot per target — its single best frame across
#   the whole track (scored on sharpness + on-target size + confidence, minus
#   an edge-truncation penalty). Snapshots are written when the video ends, so
#   they appear in the result ZIP (live thumbnails stay as previews only).
SAVE_FRAMES_MODE=unique_targets
# unique_targets only: min seconds between re-saves of the same track (0 = no
# throttling, behaves like detections_only)
TRACK_SAVE_COOLDOWN_SEC=10
# best_shot only: relative scoring weights (normalised internally) + saturation
# references. Raise AREA weight to favour close/large shots, SHARPNESS to favour
# in-focus shots. AREA_REF is the box/frame area fraction that maxes the area
# term (small for small-object scenes). MIN_SCORE drops a target's snapshot if
# even its best frame scores below this (0 = always keep one per target).
BEST_SHOT_WEIGHT_SHARPNESS=0.4
BEST_SHOT_WEIGHT_AREA=0.3
BEST_SHOT_WEIGHT_CONFIDENCE=0.3
BEST_SHOT_SHARPNESS_REF=200.0
BEST_SHOT_AREA_REF=0.05
BEST_SHOT_EDGE_MARGIN_PX=4
BEST_SHOT_EDGE_PENALTY=0.6
BEST_SHOT_MIN_SCORE=0.0
JPEG_QUALITY=85

# Visualization settings
BOX_THICKNESS=6
CORNER_LENGTH=40

# ByteTrack parameters
# TRACK_THRESH should be aligned with BOX_THRESHOLD; otherwise ByteTrack
# silently filters out low-score detector boxes (typical for small objects).
TRACK_THRESH=0.25
TRACK_BUFFER=30
MATCH_THRESH=0.8

# Frame sampling: run detection every N frames, track in between
DETECTION_INTERVAL=5

# Max concurrent tasks (GPU memory constraint)
MAX_CONCURRENT_TASKS=2

# Optional: Redis URL for Celery task queue
# REDIS_URL=redis://localhost:6379/0


# Auto-added by init_postgres.sh
DATABASE_URL=postgresql+asyncpg://sod_app:QRDCgs4YUOZSAtd3kesX949w@localhost:5432/sod
